#include &lt;iostream&gt;
#include &lt;cstring&gt;
using namespace std;
#define INF 9999999
#define V 8
// Матриця суміжності графа
int G[V][V] = {
{0, 8, 1, 5, 3, INF, INF, INF},
{8, 0, INF, INF, 6, 1, INF, INF},
{1, INF, 0, 6, INF, 7, INF, 3},
{5, INF, 6, 0, 2, INF, INF, INF},
{3, 6, INF, 2, 0, INF, 9, INF},
{INF, 1, 7, INF, INF, 0, 3, 1},
{INF, INF, INF, INF, 9, 3, 0, 4},
{INF, INF, 3, INF, INF, 1, 4, 0}
};
int main() {
int selected[V];
memset(selected, false, sizeof(selected));
int no_edge = 0;
// Стартуємо з вершини 0 (що відповідає вершині 1 у варіанті)
selected[0] = true;
cout &lt;&lt; &quot;Edge&quot; &lt;&lt; &quot; : &quot; &lt;&lt; &quot;Weight&quot; &lt;&lt; endl;
while (no_edge &lt; V - 1) {
int min = INF;
int x = 0;
int y = 0;
for (int i = 0; i &lt; V; i++) {
if (selected[i]) {
for (int j = 0; j &lt; V; j++) {
if (!selected[j] &amp;&amp; G[i][j] != INF &amp;&amp; G[i][j] != 0) {
if (min &gt; G[i][j]) {
min = G[i][j];
x = i;
y = j;
}
}
}
}
}
cout &lt;&lt; (x + 1) &lt;&lt; &quot; - &quot; &lt;&lt; (y + 1) &lt;&lt; &quot; : &quot; &lt;&lt; G[x][y] &lt;&lt; endl;
selected[y] = true;
no_edge++;
}
return 0;
}


//Код програми(Алгоритм Крускала)---------------------
#include &lt;iostream&gt;
#include &lt;vector&gt;
#include &lt;algorithm&gt;
using namespace std;
#define edge pair&lt;int, int&gt;
class Graph {
private:
vector&lt;pair&lt;int, edge&gt;&gt; G;
vector&lt;pair&lt;int, edge&gt;&gt; T;
int *parent;
int V;
public:
Graph(int V);
void AddWeightedEdge(int u, int v, int w);
int find_set(int i);
void union_set(int u, int v);
void kruskal();
void print();};
Graph::Graph(int V) {
this-&gt;V = V;
parent = new int[V];
for (int i = 0; i &lt; V; i++)
parent[i] = i;
G.clear();
T.clear();}
void Graph::AddWeightedEdge(int u, int v, int w) {
G.push_back(make_pair(w, edge(u, v)));}
int Graph::find_set(int i) {
if (i == parent[i])
return i;
return find_set(parent[i]);}
void Graph::union_set(int u, int v) {
int root_u = find_set(u);
int root_v = find_set(v);
parent[root_u] = root_v;}
void Graph::kruskal() {
int uRep, vRep;
sort(G.begin(), G.end());
for (int i = 0; i &lt; G.size(); i++) {
uRep = find_set(G[i].second.first);
vRep = find_set(G[i].second.second);
if (uRep != vRep) {
T.push_back(G[i]);
union_set(uRep, vRep); } }}
void Graph::print() {
cout &lt;&lt; &quot;Edge : Weight&quot; &lt;&lt; endl;
for (int i = 0; i &lt; T.size(); i++) {
cout &lt;&lt; T[i].second.first &lt;&lt; &quot; - &quot; &lt;&lt; T[i].second.second &lt;&lt; &quot; : &quot;
&lt;&lt; T[i].first &lt;&lt; endl; }}
int main() {
Graph g(9); // Використовуємо індекси 1..8 безпосередньо
g.AddWeightedEdge(1, 3, 1); g.AddWeightedEdge(2, 6, 1); g.AddWeightedEdge(6, 8, 1);
g.AddWeightedEdge(4, 5, 2); g.AddWeightedEdge(1, 5, 3); g.AddWeightedEdge(6, 7, 3);
g.AddWeightedEdge(3, 8, 3); g.AddWeightedEdge(7, 8, 4); g.AddWeightedEdge(1, 4, 5);
g.AddWeightedEdge(3, 4, 6); g.AddWeightedEdge(2, 5, 6); g.AddWeightedEdge(3, 6, 7);
g.AddWeightedEdge(1, 2, 8); g.AddWeightedEdge(5, 7, 9);
g.kruskal();
g.print();
return 0;
}
