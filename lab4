import math
# Константи та словник позицій літер
M_DIV = 13
M_MULT = 16
WORDS = ["БАГАТСТВО", "НЕ", "В", "ГРОШАХ", "А", "В", "ДОБРОМУ", "СЕРЦІ"]

LETTER_POSITIONS = {
    'А': 1, 'Б': 2, 'В': 3, 'Г': 4, 'Ґ': 5, 'Д': 6, 'Е': 7, 'Є': 8, 'Ж': 9, 'З': 10,
    'И': 11, 'І': 12, 'Ї': 13, 'Й': 14, 'К': 15, 'Л': 16, 'М': 17, 'Н': 18, 'О': 19,
    'П': 20, 'Р': 21, 'С': 22, 'Т': 23, 'У': 24, 'Ф': 25, 'Х': 26, 'Ц': 27, 'Ч': 28,
    'Ш': 29, 'Щ': 30, 'Ь': 31, 'Ю': 32, 'Я': 33
}

def get_word_key(key: str) -> int:
    sum_of_positions = 0
    for char in key:
        sum_of_positions += LETTER_POSITIONS.get(char, 0)
    return sum_of_positions
    
def hash_division(key: str, m: int = M_DIV) -> int:
    k = get_word_key(key)
    return k % m
    
def hash_multiplication(key: str, m: int = M_MULT) -> int:
    k = get_word_key(key)
    A = (math.sqrt(5) - 1) / 2
    return math.floor(m * ((k * A) % 1))
    
def build_open_hash_table(words: list, m: int, hash_func) -> list:
    hash_table = [[] for _ in range(m)]
    for word in words:
        address = hash_func(word, m)
        hash_table[address].append(word)
    return hash_table
    
def build_closed_hash_table(words: list, m: int, hash_func) -> list:
    hash_table = [None] * m
    for word in words:
        start_address = hash_func(word, m)
        for i in range(m):
            address = (start_address + i) % m
            if hash_table[address] is None:
                hash_table[address] = word
                break
    return hash_table
    
def display_open_table(table: list, title: str):
    print(f"\n--- {title} ---")
    for i, chain in enumerate(table):
        print(f"Індекс {i:02d}: {chain}")
        
def display_closed_table(table: list, title: str):
    print(f"\n--- {title} ---")
    for i, item in enumerate(table):
        value = item if item is not None else "(NULL)"
        print(f"{i:02d}     | {value}")

# Виконання
open_div = build_open_hash_table(WORDS, M_DIV, hash_division)
closed_div = build_closed_hash_table(WORDS, M_DIV, hash_division)
open_mult = build_open_hash_table(WORDS, M_MULT, hash_multiplication)
closed_mult = build_closed_hash_table(WORDS, M_MULT, hash_multiplication)

display_open_table(open_div, "Відкрита хеш-таблиця (Ділення, M=13)")
display_closed_table(closed_div, "Закрита хеш-таблиця (Ділення, M=13)")
display_open_table(open_mult, "Відкрита хеш-таблиця (Множення, M=16)")
display_closed_table(closed_mult, "Закрита хеш-таблиця (Множення, M=16)")
