#include <iostream>
#include <vector>
#include <iomanip>
#include <algorithm>
using namespace std;

const int INF = 1e9;
const int V = 8;

int W[V][V] = {
    {0,   8,   1,   5,   3,   INF, INF, INF},
    {8,   0,   INF, INF, 6,   1,   INF, INF},
    {1,   INF, 0,   6,   INF, 7,   INF, 3  },
    {5,   INF, 6,   0,   2,   INF, INF, INF},
    {3,   6,   INF, 2,   0,   INF, 9,   INF},
    {INF, 1,   7,   INF, INF, 0,   3,   1  },
    {INF, INF, INF, INF, 9,   3,   0,   4  },
    {INF, INF, 3,   INF, INF, 1,   4,   0  }
};

void dijkstra(int start) {
    vector<int> dist(V, INF);
    vector<bool> visited(V, false);
    dist[start] = 0;

    for (int i = 0; i < V; ++i) {
        int u = -1;
        for (int j = 0; j < V; ++j) {
            if (!visited[j] && (u == -1 || dist[j] < dist[u])) {
                u = j;
            }
        }
        if (dist[u] == INF) break;
        visited[u] = true;

        for (int v = 0; v < V; ++v) {
            if (W[u][v] != INF && dist[u] + W[u][v] < dist[v]) {
                dist[v] = dist[u] + W[u][v];
            }
        }
    }

    cout << "--- Результати алгоритму Дейкстри від вершини " << start + 1 << " ---" << endl;
    for (int i = 0; i < V; ++i) {
        cout << "До вершини " << i + 1 << ": відстань = " << dist[i] << endl;
    }
}

void floyd() {
    int D[V][V];
    for (int i = 0; i < V; ++i)
        for (int j = 0; j < V; ++j)
            D[i][j] = W[i][j];

    for (int k = 0; k < V; ++k) {
        for (int i = 0; i < V; ++i) {
            for (int j = 0; j < V; ++j) {
                if (D[i][k] != INF && D[k][j] != INF && D[i][k] + D[k][j] < D[i][j]) {
                    D[i][j] = D[i][k] + D[k][j];
                }
            }
        }
    }

    cout << "\n--- Фінальна матриця найкоротших відстаней (Алгоритм Флойда D^8) ---" << endl;
    for (int i = 0; i < V; ++i) {
        for (int j = 0; j < V; ++j) {
            if (D[i][j] == INF) cout << setw(5) << "INF";
            else cout << setw(5) << D[i][j];
        }
        cout << endl;
    }
}

int main() {
    dijkstra(0); // Від вершини 1 (індекс 0)
    floyd();
    return 0;
}
